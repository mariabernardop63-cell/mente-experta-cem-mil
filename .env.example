# ============================================================================
#  MenteExperta — variáveis de ambiente
#  Copie para `.env` (`cp .env.example .env`) e preencha os valores.
#  O `.env` está no .gitignore — nunca é enviado para o repositório.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Assistente de apoio (chat do site) — TokenHarbor
#    Sem isto, o chat responde "atendimento automático ainda não está conectado".
# ---------------------------------------------------------------------------
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free

# ---------------------------------------------------------------------------
# 2. Base de dados e PDFs — Supabase
#    Project Settings → API → Project URL  e  service_role key (secreta).
#    Antes de usar, execute `supabase/schema.sql` no SQL Editor do Supabase.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 3. Painel /admin — credenciais e assinatura da sessão
#    ADMIN_SESSION_SECRET: segredo aleatório longo (>= 32 caracteres).
#      Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#    Se ficar vazio, o cookie é assinado com a própria password.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# 4. Pagamentos PIX — InfiniGate
#    Painel InfiniGate → Webhooks & APIs. `deposit` cria cobranças;
#    `webhook` valida a assinatura das notificações.
#    A URL do webhook pode ser configurada no painel ou é enviada por pedido.
# ---------------------------------------------------------------------------
INFINIGATE_DEPOSIT_KEY=
INFINIGATE_WEBHOOK_KEY=
INFINIGATE_BASE_URL=https://api.infini-gate.com

# ---------------------------------------------------------------------------
# 5. Transferência e-Mola (Moçambique)
#    Números mostrados na tela de pagamento MZ.
# ---------------------------------------------------------------------------
EMOLA_PERSONAL_NUMBER=8738373838
EMOLA_PERSONAL_HOLDER=MenteExperta
EMOLA_COMPANY_NUMBER=8783838929
EMOLA_COMPANY_NAME=Experience Beta

# ---------------------------------------------------------------------------
# 6. URL pública do site
#    Usada para montar o webhookUrl enviado à InfiniGate.
#    Em produção: https://seudominio.com  (sem barra final)
#    Em local/preview pode ficar vazio (usa o host do pedido).
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=
